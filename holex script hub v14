        if not vc then return end
        if vc._pending and not vc.InCall then
            vc._pending = nil
            pcall(function()
                if vc.RingtoneSound then vc.RingtoneSound:Stop() end
            end)
            -- stop ringtone helper
            pcall(function()
                local Play = nil
            end)
            -- use HangUp path for ringtone stop
            pcall(function()
                if getgenv().HolexVoiceCall then
                    local s = getgenv().HolexVoiceCall.RingtoneSound
                    if s then s:Stop() s:Destroy() getgenv().HolexVoiceCall.RingtoneSound = nil end
                end
            end)
            HolexLib:Notify("Voice", "Declined", 3)
        else
            vc:HangUp()
        end
        refreshVoiceStatus()
    end
})

