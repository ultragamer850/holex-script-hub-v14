local listSec = FriendsTab:CreateSection("Your Holex Friends")
local function refreshFriendsTabList()
    pcall(function()
        if getgenv().HolexPublishPresence then getgenv().HolexPublishPresence() end
        if getgenv().HolexPollNetwork then getgenv().HolexPollNetwork() end
    end)
    for _, child in ipairs(listSec.Content:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextLabel") or child:IsA("TextButton") then
            if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
                child:Destroy()
            end
        end
    end
    local friends = UserData.HolexFriends or {}
    local online = (getgenv().HolexGetOnline and getgenv().HolexGetOnline()) or {}
    local count = 0
    for uname, fdata in pairs(friends) do
        count = count + 1
        local isOnline = false
        for _, p in pairs(online) do
            if type(p) == "table" and p.username and string.lower(p.username) == string.lower(uname) then
                if os.time() - (p.lastSeen or 0) <= 45 then
                    isOnline = true
                    break
                end
            end
        end
        local status = isOnline and "ONLINE · Holex V14" or "Offline"
        listSec:CreateParagraph({
            Title = uname .. "  ·  " .. status,
            Content = "Added: " .. os.date("%Y-%m-%d", fdata.addedAt or os.time()) .. (isOnline and "\nRunning Holex Script Hub V14" or "")
        })
        listSec:CreateButton({
            Title = "Open " .. uname,
            Callback = function()
                if getgenv().HolexOpenFriendProfile then
                    getgenv().HolexOpenFriendProfile(uname)
                end
            end
        })
    end
    if count == 0 then
        listSec:CreateParagraph({
            Title = "No friends yet",
            Content = "Add their Holex username above. Online = they are running Holex V14."
        })
    end
end
getgenv().HolexRefreshFriendsTab = refreshFriendsTabList
