local function CreateHolexGroup(name, members)
    name = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if #name < 2 then return false, "Name too short" end
    if #name > 32 then return false, "Name max 32 chars" end
    UserData.HolexGroups = UserData.HolexGroups or {}
    local id = "g_" .. tostring(math.floor(tick() * 1000)) .. "_" .. tostring(math.random(100, 999))
    local mem = {}
    if type(members) == "table" then
        for _, m in ipairs(members) do
            if type(m) == "string" and m ~= "" then table.insert(mem, m) end
        end
    end
    -- Always include self
    local selfName = UserData.Username or Player.Name
    local hasSelf = false
    for _, m in ipairs(mem) do if m:lower() == selfName:lower() then hasSelf = true break end end
    if not hasSelf then table.insert(mem, 1, selfName) end
    UserData.HolexGroups[id] = {
        id = id,
        name = name,
        members = mem,
        owner = selfName,
        created = os.time(),
        discordLink = "",
    }
    SaveHolexGroups()
    HolexLogger:Success("GROUPS", "Created group: " .. name)
    return true, id
end

local function DeleteHolexGroup(groupId)
    if UserData.HolexGroups and UserData.HolexGroups[groupId] then
        local n = UserData.HolexGroups[groupId].name
        UserData.HolexGroups[groupId] = nil
        SaveHolexGroups()
        return true, n
    end
    return false, "Not found"
end

local function AddMemberToGroup(groupId, username)
    local g = UserData.HolexGroups and UserData.HolexGroups[groupId]
    if not g then return false, "Group not found" end
    username = tostring(username or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if username == "" then return false, "Empty username" end
    for _, m in ipairs(g.members or {}) do
        if m:lower() == username:lower() then return false, "Already in group" end
    end
    table.insert(g.members, username)
    SaveHolexGroups()
    return true, "Added " .. username
end

local function RemoveMemberFromGroup(groupId, username)
    local g = UserData.HolexGroups and UserData.HolexGroups[groupId]
    if not g then return false, "Group not found" end
    local out = {}
    for _, m in ipairs(g.members or {}) do
        if m:lower() ~= tostring(username):lower() then table.insert(out, m) end
    end
    g.members = out
    SaveHolexGroups()
    return true
end

