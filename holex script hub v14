local function ApplyTheme(themeName)
    local theme = Themes[themeName] or Themes.Default
    if theme.Fore then Config.AccentColor = theme.Fore end
    if theme.Back then
        Config.MainColor = theme.Back
        -- derive secondary panels from back
        local b = theme.Back
        Config.SecondaryColor = Color3.new(math.min(1, b.R + 0.03), math.min(1, b.G + 0.03), math.min(1, b.B + 0.04))
        Config.TertiaryColor = Color3.new(math.min(1, b.R + 0.06), math.min(1, b.G + 0.06), math.min(1, b.B + 0.08))
        Config.QuaternaryColor = Color3.new(math.min(1, b.R + 0.09), math.min(1, b.G + 0.09), math.min(1, b.B + 0.11))
        Config.InputBG = Color3.new(math.min(1, b.R + 0.04), math.min(1, b.G + 0.04), math.min(1, b.B + 0.05))
    end
    if theme.Text then
        Config.TextColor = theme.Text
        Config.SubTextColor = Color3.new(theme.Text.R * 0.72, theme.Text.G * 0.72, theme.Text.B * 0.75)
        Config.DimTextColor = Color3.new(theme.Text.R * 0.45, theme.Text.G * 0.45, theme.Text.B * 0.5)
    end
    Config.Theme = themeName
    -- Live-update accent + main surfaces
    pcall(function()
        for _, obj in pairs(AccentElements.Backgrounds or {}) do
            if obj and obj.Parent then obj.BackgroundColor3 = Config.AccentColor end
        end
        for _, obj in pairs(AccentElements.Texts or {}) do
            if obj and obj.Parent then obj.TextColor3 = Config.AccentColor end
        end
        for _, obj in pairs(AccentElements.Strokes or {}) do
            if obj and obj.Parent then obj.Color = Config.AccentColor end
        end
        -- Update main frame + sidebar if open
        if ScreenGui then
            local main = ScreenGui:FindFirstChild("MainFrame")
            if main then
                main.BackgroundColor3 = Config.MainColor
                for _, d in ipairs(main:GetDescendants()) do
                    if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                        if d.TextColor3 == Color3.fromRGB(245, 247, 252) or d.Name == "Title" then
                            pcall(function() d.TextColor3 = Config.TextColor end)
                        end
                    end
                    if d:IsA("Frame") and d.Name == "Sidebar" then
                        d.BackgroundColor3 = Config.SecondaryColor
                    end
                    if d:IsA("UIStroke") and d.Thickness >= 1 then
                        pcall(function() d.Color = Config.AccentColor end)
                    end
                end
            end
        end
    end)
    -- Optional click SFX from theme
    if theme.SndClick and GlobalSFX then
        pcall(function()
            GlobalSFX.ClickAsset = theme.SndClick
        end)
    end
    pcall(function()
        if writefile then writefile(HOLEX_DATA .. "/theme.txt", themeName) end
    pcall(SaveHubSettings)
    end)
end

