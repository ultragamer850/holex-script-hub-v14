local function HandleEvent(ev)
    if not ev or not ev.id then return end
    if Net.SeenIds[ev.id] then return end
    Net.SeenIds[ev.id] = true
    local msg = tostring(ev.message or "")
    local parts = {}
    for part in string.gmatch(msg, "[^|]+") do
        table.insert(parts, part)
    end
    local kind = parts[1]
    if kind == "presence" then
        local uname = parts[2]
        local ts = tonumber(parts[3]) or os.time()
        local ver = parts[4] or HOLEX_VERSION
        local uid = tonumber(parts[5])
        local display = parts[6] or uname
        local guest = parts[7] == "1"
        local joined = tonumber(parts[8])
        if uname then
            MarkOnline(uname, {
                display = display,
                userid = uid,
                lastSeen = ts,
                version = ver,
                isGuest = guest,
                joinedAt = joined,
            })
            NotifyFriendOnline(uname)
        end
    elseif kind == "chat" then
        local uname = parts[2]
        local textMsg = parts[3] or ""
        local ts = tonumber(parts[4]) or os.time()
        if uname and textMsg ~= "" then
            addChatMsg(uname, textMsg, Config.AccentColor, ts)
            MarkOnline(uname, { lastSeen = ts, display = uname })
        end
    elseif kind == "typing" then
        local uname = parts[2]
        local ts = tonumber(parts[3]) or os.time()
        if uname then
            getgenv().HolexTypingUsers[uname] = { at = ts }
        end
    elseif kind == "dm" then
        -- handled in DM window primarily
        local fromU, toU, textMsg = parts[2], parts[3], parts[4]
        local me = GetChatUsername()
        if me and toU and string.lower(toU) == string.lower(me) and fromU then
            HolexLib:Notify("DM from " .. fromU, textMsg or "", 5, Config.AccentColor)
        end
    end
end

local function PollNetwork()
    local events = NtfyPoll(NTFY_LOBBY, "2h")
    for _, ev in ipairs(events) do
        pcall(HandleEvent, ev)
    end
    -- typing label
    local me = GetChatUsername()
    local typers = {}
    local now = os.time()
    for uname, t in pairs(getgenv().HolexTypingUsers or {}) do
        if type(t) == "table" and now - (t.at or 0) <= 6 then
            if not me or string.lower(uname) ~= string.lower(me) then
                table.insert(typers, uname)
            end
        end
    end
    if #typers == 0 then
        TypingLabel.Text = ""
    elseif #typers == 1 then
        TypingLabel.Text = typers[1] .. " is typing..."
    else
        TypingLabel.Text = table.concat(typers, ", ") .. " are typing..."
    end
    -- status
    local nOnline = 0
    for k, p in pairs(getgenv().HolexCloudPresence or {}) do
        if type(p) == "table" and p.username and k == p.username then
            if now - (p.lastSeen or 0) <= 45 then
                nOnline = nOnline + 1
            end
        end
    end
    local uname = me or "?"
    ChatStatus.Text = string.format("GLOBAL NETWORK | %s | %d online", uname, nOnline)
    ChatStatus.TextColor3 = Config.SuccessColor
    if statusPara and statusPara.SetValue then
        statusPara:SetValue("CONNECTED to Holex V14 global network\n" .. nOnline .. " user(s) online · works across games")
    end
end

local function sendMsg()
    local uname = GetChatUsername()
    if not uname then
        addChatMsg("SYSTEM", "Log in with your Holex account first.", Config.WarningColor)
        return
    end
    local txt = string.match(ChatMsgInput.Text or "", "^%s*(.-)%s*$") or ""
    if txt == "" then return end
    ChatMsgInput.Text = ""
    if #txt > 300 then
        addChatMsg("SYSTEM", "Max 300 characters", Config.ErrorColor)
        return
    end
    PublishChat(txt)
    PublishPresence()
    addChatMsg(uname, txt, Config.AccentColor, os.time())
    HolexLogger:Info("CHAT", uname .. ": " .. txt)
end

