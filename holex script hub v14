-- Ensure parent folders exist before any writefile
local function HolexEnsureDir(path)
    pcall(function()
        if not path or path == "" then return end
        -- If path looks like a file, use parent folder
        local folder = path
        if path:find("%.[%w]+$") then
            folder = path:match("(.+)/[^/]+$") or HOLEX_DATA
        end
        if folder and isfolder and not isfolder(folder) then
            -- create nested under HolexData
            local acc = ""
            for part in string.gmatch(folder, "[^/]+") do
                acc = (acc == "") and part or (acc .. "/" .. part)
                if not isfolder(acc) then
                    pcall(function() makefolder(acc) end)
                end
            end
        end
    end)
end

