local function HolexStopEverything()
    -- Music
    pcall(function()
        if CurrentMusic and CurrentMusic.Sound then
            CurrentMusic.Sound:Stop()
            CurrentMusic.Sound:Destroy()
            CurrentMusic.Sound = nil
            CurrentMusic.Playing = false
            CurrentMusic.Name = "None"
        end
    end)
    -- Voice / ringtone
    pcall(function()
        if VoiceCall then
            if VoiceCall.RingtoneSound then
                VoiceCall.RingtoneSound:Stop()
                VoiceCall.RingtoneSound:Destroy()
                VoiceCall.RingtoneSound = nil
            end
            VoiceCall.InCall = false
        end
        if getgenv()._HolexRingTest then
            getgenv()._HolexRingTest:Stop()
            getgenv()._HolexRingTest:Destroy()
            getgenv()._HolexRingTest = nil
        end
    end)
    -- All Holex sounds
    pcall(function()
        for _, parent in ipairs({SoundService, CoreGui, Player:FindFirstChild("PlayerGui")}) do
            if parent then
                for _, s in ipairs(parent:GetDescendants()) do
                    if s:IsA("Sound") then
                        local n = tostring(s.Name)
                        if n:find("Holex") or n:find("holex") or n:find("Ringtone") or n:find("ClockTick")
                            or n:find("Cinematic") or n:find("Finale") or n:find("Notif") or n:find("GlobalSFX") then
                            pcall(function() s:Stop() s:Destroy() end)
                        end
                    end
                end
            end
        end
    end)
    -- Extra GUIs
    pcall(function()
        local parent = (gethui and gethui()) or CoreGui
        for _, name in ipairs({
            "HolexVideoPlayer", "HolexExecutor", "HolexRawViewer", "HolexBreakingNewsGUI",
            "HolexDigitalClock", "HolexIntro_Undertale", "HolexIntro_FX", "HolexIntro_v14",
            "HolexLoadingScreen", "HolexCallOverlay"
        }) do
            local g = parent:FindFirstChild(name)
            if g then pcall(function() g:Destroy() end) end
            local pg = Player:FindFirstChild("PlayerGui")
            if pg then
                local g2 = pg:FindFirstChild(name)
                if g2 then pcall(function() g2:Destroy() end) end
            end
        end
    end)
    pcall(function()
        if getgenv().HolexDigitalClock and getgenv().HolexDigitalClock.Destroy then
            getgenv().HolexDigitalClock:Destroy()
        end
    end)
    pcall(function() HolexLogger:Info("SYSTEM", "Holex fully closed — all audio stopped") end)
end
getgenv().HolexStopEverything = HolexStopEverything

local function HolexFullExit()
    pcall(HolexStopEverything)
