local voiceStatusPara = vInfo:CreateParagraph({
    Title = "Call Status",
    Content = "Idle — not in a call"
})

local function refreshVoiceStatus()
    local vc = getgenv().HolexVoiceCall
    if not vc then return end
    local txt
    if vc.InCall then
        local elapsed = math.max(0, os.time() - (vc.StartedAt or os.time()))
        local mm = math.floor(elapsed / 60)
        local ss = elapsed % 60
        txt = string.format(
            "IN CALL\nTarget: %s\nType: %s\nDuration: %02d:%02d\nMic: %s | Muted: %s | Deafened: %s\nParticipants: %s\nDiscord: %s",
            tostring(vc.Target),
            vc.IsGroup and "Group" or "1:1",
            mm, ss,
            tostring(vc.MicDevice),
            tostring(vc.Muted),
            tostring(vc.Deafened),
            table.concat(vc.Participants or {}, ", "),
            (vc.DiscordInvite ~= "" and vc.DiscordInvite) or "(none)"
        )
    else
        local pending = vc._pending
        if pending then
            txt = "INCOMING from " .. tostring(pending.from) .. "\nOpen Accept / Decline below"
        else
            txt = "Idle — not in a call\nMic device: " .. tostring(UserData.VoiceSettings and UserData.VoiceSettings.MicDevice or "Default")
        end
    end
    if voiceStatusPara and voiceStatusPara.SetValue then voiceStatusPara:SetValue(txt) end
end

task.spawn(function()
    while true do
        pcall(refreshVoiceStatus)
        task.wait(1)
    end
end)

