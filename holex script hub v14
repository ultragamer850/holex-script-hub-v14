                    online["net:" .. string.lower(tostring(p.username))] = {
                        username = p.username,
                        display = p.display or p.username,
                        userid = p.userid,
                        lastSeen = p.lastSeen,
                        version = p.version or HOLEX_VERSION,
                        hub = "HolexScriptHubV14",
                        source = "ntfy",
                    }
                end
            end
        end)
        return online
    end

    local function AddHolexFriend(targetUsername)
        if not targetUsername or targetUsername == "" then return false, "Empty username" end
        targetUsername = targetUsername:match("^%s*(.-)%s*$")
        if targetUsername == UserData.Username then return false, "Cannot add yourself" end
        UserData.HolexFriends = UserData.HolexFriends or {}
        if UserData.HolexFriends[targetUsername] then return false, "Already friends" end
        UserData.HolexFriends[targetUsername] = {
            username = targetUsername,
            addedAt = os.time(),
            display = targetUsername
        }
        SaveHolexFriends()
        SaveUserData()
        HolexLogger:Success("FRIENDS", "Added Holex friend: " .. targetUsername)
        return true, "Added " .. targetUsername
    end

    local function RemoveHolexFriend(targetUsername)
        if UserData.HolexFriends and UserData.HolexFriends[targetUsername] then
            UserData.HolexFriends[targetUsername] = nil
            SaveHolexFriends()
            SaveUserData()
            return true
        end
        return false
    end

    local function refreshFriendsList()
        for _, child in ipairs(FriendsScroll:GetChildren()) do
            if child:IsA("Frame") or child:IsA("TextLabel") or child:IsA("TextButton") then
                if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
                    child:Destroy()
                end
