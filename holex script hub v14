    local function showExploitDetails(ex)
        if type(ex) ~= "table" then return end
        local title = ex.title or ex.name or "?"
        local updated = ex.updateStatus == true
        local detected = ex.detected == true
        local free = ex.free == true
        local unc = ex.uncStatus == true
        local ver = tostring(ex.version or "?")
        local rbx = tostring(ex.rbxversion or "?")
        local platform = tostring(ex.platform or ex.extype or "?")
        local cost = tostring(ex.cost or (free and "Free" or "Paid"))
        local web = tostring(ex.websitelink or ex.website or "")
        local disc = tostring(ex.discordlink or ex.discord or "")
        local purchase = tostring(ex.purchaselink or "")
        local updatedDate = tostring(ex.updatedDate or "")

        local statusLine = updated and "✅ UPDATED (online / working)" or "❌ NOT UPDATED"
        local detLine = detected and "⚠ DETECTED by Hyperion" or "🛡 UNDETECTED / bypass OK"
        local msg = table.concat({
            title .. "  v" .. ver,
            statusLine,
            detLine,
            "UNC: " .. fmtBool(unc, "Yes", "No"),
            "Platform: " .. platform,
            "Cost: " .. cost,
            "Roblox build: " .. rbx,
            "Last update: " .. updatedDate,
            web ~= "" and ("Website: " .. web) or nil,
            disc ~= "" and ("Discord: " .. disc) or nil,
            purchase ~= "" and ("Purchase: " .. purchase) or nil,
        }, "\n")

        HolexLib:Notify(title, statusLine .. " | " .. detLine, 8, updated and (not detected) and Config.SuccessColor or Config.WarningColor)
        pcall(function()
            if setclipboard then
                local clip = title .. "\n" .. statusLine .. "\n" .. detLine
                if web ~= "" then clip = clip .. "\n" .. web end
                if disc ~= "" then clip = clip .. "\n" .. disc end
                setclipboard(clip)
            end
        end)
        -- Detail paragraph update
        if listPara and listPara.SetValue then
            listPara:SetValue(msg)
        end
    end

    local function refreshWeao()
        task.spawn(function()
            HolexLib:Notify("WEAO", "Fetching status...", 2)
            local versions = weaoRequest("https://weao.xyz/api/versions/current")
                or weaoRequest("https://whatexpsare.online/api/versions/current")
            local exploits = weaoRequest("https://weao.xyz/api/status/exploits")
                or weaoRequest("https://whatexpsare.online/api/status/exploits")

            if type(versions) == "table" then
                WeaoCache.versions = versions
                local win = versions.Windows or versions.windows or "?"
                local mac = versions.Mac or versions.mac or "?"
                local winDate = versions.WindowsDate or versions.windowsDate or ""
                local macDate = versions.MacDate or versions.macDate or ""
                local txt = string.format(
                    "Windows: %s\nUpdated: %s\n\nMac: %s\nUpdated: %s",
                    tostring(win), tostring(winDate), tostring(mac), tostring(macDate)
                )
                if rbxPara and rbxPara.SetValue then rbxPara:SetValue(txt) end
            else
                if rbxPara and rbxPara.SetValue then
                    rbxPara:SetValue("Could not load versions (need request + User-Agent WEAO-3PService).\nOpen https://whatexpsare.online/")
                end
            end

            local list = {}
            if type(exploits) == "table" then
                if exploits[1] then
                    list = exploits
                else
                    for _, v in pairs(exploits) do
                        if type(v) == "table" and (v.title or v.name) then
                            table.insert(list, v)
                        end
                    end
                end
            end
            WeaoCache.exploits = list

            if #list == 0 then
                if listPara and listPara.SetValue then
                    listPara:SetValue("No exploit data. Your executor may block the API.\nTry again or open https://whatexpsare.online/")
                end
                HolexLib:Notify("WEAO", "No data — open site in browser", 5, Config.WarningColor)
                return
            end

            local lines = {}
            local updatedN, undetectedN = 0, 0
            for _, ex in ipairs(list) do
                local name = ex.title or ex.name or "?"
                local st = (ex.updateStatus == true) and "Updated" or "Not Updated"
                local det = (ex.detected == true) and "Detected" or "Undetected"
                if ex.updateStatus == true then updatedN = updatedN + 1 end
                if ex.detected ~= true then undetectedN = undetectedN + 1 end
                table.insert(lines, string.format("%s | %s | %s | %s", name, tostring(ex.version or ""), st, det))
            end
            table.insert(lines, 1, string.format("Total: %d | Updated: %d | Undetected: %d", #list, updatedN, undetectedN))
            if listPara and listPara.SetValue then
                listPara:SetValue(table.concat(lines, "\n"))
            end
            HolexLib:Notify("WEAO", string.format("%d executors · %d updated · %d undetected", #list, updatedN, undetectedN), 5, Config.SuccessColor)
        end)
    end

    wSec:CreateButton({
        Title = "🔄 Refresh WEAO Status",
        Description = "Fetch Roblox versions + all executors",
        Callback = refreshWeao
    })

    wSec:CreateButton({
        Title = "✅ Show Updated Only",
        Description = "Filter: updateStatus = true",
        Callback = function()
            local lines = {"Updated executors:"}
            for _, ex in ipairs(WeaoCache.exploits) do
                if ex.updateStatus == true then
                    table.insert(lines, (ex.title or "?") .. " v" .. tostring(ex.version or "") .. (ex.detected and " [DETECTED]" or " [UNDETECTED]"))
                end
            end
            if listPara and listPara.SetValue then listPara:SetValue(table.concat(lines, "\n")) end
        end
    })

    wSec:CreateButton({
        Title = "🛡 Show Undetected Only",
        Description = "Filter: not detected by Hyperion",
        Callback = function()
            local lines = {"Undetected executors:"}
            for _, ex in ipairs(WeaoCache.exploits) do
                if ex.detected ~= true then
                    local st = ex.updateStatus and "Updated" or "Not Updated"
                    table.insert(lines, (ex.title or "?") .. " · " .. st .. " · v" .. tostring(ex.version or ""))
                end
            end
            if listPara and listPara.SetValue then listPara:SetValue(table.concat(lines, "\n")) end
        end
    })

    -- Per-platform sections + buttons for each exploit after refresh
    local platformSec = WeaoTab:CreateSection("Executor Buttons (click for details)")
    platformSec:CreateParagraph({
        Title = "How to use",
        Content = "1) Press Refresh WEAO Status\n2) Press Build Executor Buttons\n3) Click any executor for undetected/bypass, links, discord, Roblox build"
    })

    platformSec:CreateButton({
        Title = "📋 Build Executor Buttons",
        Description = "Create a button for every executor from last refresh",
        Callback = function()
            if #WeaoCache.exploits == 0 then
                HolexLib:Notify("WEAO", "Refresh first", 3, Config.WarningColor)
                return
            end
            -- Group by platform-ish
            local byPlat = { Windows = {}, Mac = {}, Android = {}, iOS = {}, External = {}, Other = {} }
            for _, ex in ipairs(WeaoCache.exploits) do
                local p = tostring(ex.platform or ex.extype or "Other"):lower()
                local bucket = "Other"
                if p:find("android") or p:find("aexec") then bucket = "Android"
                elseif p:find("ios") or p:find("iphone") or p:find("iexec") then bucket = "iOS"
                elseif p:find("mac") or p:find("mexec") then bucket = "Mac"
                elseif p:find("external") or p:find("wexternal") then bucket = "External"
                elseif p:find("win") or p:find("wexec") then bucket = "Windows"
                end
                table.insert(byPlat[bucket], ex)
            end
            for platName, arr in pairs(byPlat) do
                if #arr > 0 then
                    local sec = WeaoTab:CreateSection(platName .. " Executors (" .. #arr .. ")")
                    for _, ex in ipairs(arr) do
                        local name = ex.title or "?"
                        local badge = (ex.updateStatus and "✅" or "❌") .. (ex.detected and " ⚠" or " 🛡")
                        sec:CreateButton({
                            Title = badge .. " " .. name .. " " .. tostring(ex.version or ""),
                            Description = (ex.updateStatus and "Updated" or "Not Updated") .. " · " .. (ex.detected and "Detected" or "Undetected"),
                            Callback = function()
                                showExploitDetails(ex)
                                if ex.discordlink and setclipboard then
                                    pcall(function() setclipboard(tostring(ex.discordlink)) end)
                                end
                            end
                        })
                    end
                end
            end
            HolexLib:Notify("WEAO", "Buttons built — click any executor", 4, Config.SuccessColor)
        end
    })

    wSec:CreateButton({
        Title = "Copy WEAO Website",
        Description = "https://whatexpsare.online/",
        Callback = function()
            pcall(function() if setclipboard then setclipboard("https://whatexpsare.online/") end end)
            HolexLib:Notify("WEAO", "Link copied", 3)
        end
    })

    task.defer(refreshWeao)
    pcall(function()
        HolexLogger:Info("UI", "WEAO tab built")
        if HolexLib and HolexLib.Notify then
            HolexLib:Notify("WEAO", "WEAO Status tab ready — check the left sidebar", 4, Config.SuccessColor)
        end
    end)
