local function getNameFromURL(url)
    local name = url:match("/catalog/%d+/(.+)$") or url
    return name:gsub("-", " ")
end
local function addHatSection(label, list)
    local sec = HatListTab:CreateSection(label)
    sec:CreateParagraph({ Title = label, Content = "Click any item to copy its catalog link" })
    for _, url in ipairs(list) do
        local name = getNameFromURL(url)
        sec:CreateButton({
            Title = name, Description = "Copy catalog link",
            Callback = function()
                if setclipboard then
                    setclipboard(url)
                    HolexLib:Notify("Copied!", name .. " link copied!", 3, Config.SuccessColor)
                else
                    HolexLib:Notify("Error", "Clipboard not supported", 4, Config.ErrorColor)
                end
            end
        })
    end
end
