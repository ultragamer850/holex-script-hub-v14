function Utilities:MakeDraggable(frame, dragArea)
    dragArea = dragArea or frame
    local dragging = false
    local dragStart = nil
    local startPos = nil
    dragArea.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

function Utilities:HTTPRequest(url, method, headers, body)
    local req = (syn and syn.request) or http_request or request or (fluxus and fluxus.request) or (getgenv and getgenv().request)
    if not req then
        pcall(function()
            req = function(args)
                local resp = {}
                resp.Body = game:HttpGet(args.Url, true)
                resp.StatusCode = 200
                resp.Success = true
                return resp
            end
        end)
    end
    if not req then return nil end
    local ok, res = pcall(function()
        return req({
            Url = url,
            Method = method or "GET",
            Headers = headers or {
                ["Content-Type"] = "application/json",
                ["Accept"] = "application/json",
                ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) HolexHub/14",
            },
            Body = body
        })
    end)
    if not ok or not res then
        -- last resort HttpGet
        local ok2, body2 = pcall(function() return game:HttpGet(url) end)
        if ok2 and body2 and #tostring(body2) > 2 then
            return { Body = body2, body = body2, StatusCode = 200, Success = true }
        end
        return nil
    end
    -- normalize body field
    if type(res) == "table" then
        res.Body = res.Body or res.body or res.Data or res.data
        res.StatusCode = res.StatusCode or res.Status or res.status_code or 0
    elseif type(res) == "string" then
        res = { Body = res, body = res, StatusCode = 200, Success = true }
    end
    return res
end

function Utilities:GetTime()
    local t = os.date("*t")
    local h, m = t.hour, t.min
    if Config.Clock24Hour then return string.format("%02d:%02d", h, m) end
    local ampm = h >= 12 and "PM" or "AM"
    h = h % 12
    if h == 0 then h = 12 end
    return string.format("%02d:%02d %s", h, m, ampm)
end

