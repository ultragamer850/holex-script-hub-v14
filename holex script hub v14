        header.TextSize = 10
        header.TextColor3 = Config.AccentColor
        header.TextXAlignment = Enum.TextXAlignment.Left
        header.Text = "  HOLEX FRIENDS"
        header.Parent = FriendsScroll
        for uname, fdata in pairs(friends) do
            local isOnline, presence = false, nil
            for _, p in pairs(online) do
                if type(p) == "table" and p.username and string.lower(p.username) == string.lower(tostring(uname)) then
                    if os.time() - (p.lastSeen or 0) <= 45 then
                        isOnline = true
