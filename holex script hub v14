local function HolexHttp(url, method, body, headers)
    method = (method or "GET"):upper()
    headers = headers or {}
    local result = nil
    local function pack(r)
        if not r then return nil end
        return {
            Body = r.Body or r.body or r.Data or "",
            StatusCode = r.StatusCode or r.Status or r.status_code or 0,
            Headers = r.Headers or r.headers or {},
        }
    end
    pcall(function()
        if Utilities and Utilities.HTTPRequest then
            result = pack(Utilities:HTTPRequest(url, method, body, headers))
        end
    end)
    if not result then
        pcall(function()
            local req = (syn and syn.request) or http_request or request or (http and http.request)
            if req then
                result = pack(req({ Url = url, Method = method, Headers = headers, Body = body }))
            end
        end)
    end
    if not result and method == "GET" then
        pcall(function()
            result = { Body = game:HttpGet(url), StatusCode = 200, Headers = {} }
        end)
    end
    if not result and (method == "POST" or method == "PUT") then
        pcall(function()
            local b = game:HttpPost(url, body or "", Enum.HttpContentType.TextPlain)
            result = { Body = b or "", StatusCode = 200, Headers = {} }
        end)
    end
    return result
end

