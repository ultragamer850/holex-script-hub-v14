local function NtfyPoll(topic, since)
    since = since or "1h"
    local url = NTFY_BASE .. topic .. "/json?poll=1&since=" .. tostring(since)
    local res = HolexHttp(url, "GET")
    if not res or not res.Body or res.Body == "" then return {} end
    local events = {}
    for line in string.gmatch(res.Body, "[^\r\n]+") do
