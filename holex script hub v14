function GlobalSFX:Download()
    HolexLogger:Info("SFX", "Downloading GMod hover & click SFX to HolexData/sfx ...")
    pcall(function()
        if HolexEnsureDir then HolexEnsureDir(self.HoverPath) HolexEnsureDir(self.ClickPath) end
