    end
end

function GlobalSFX:HookAllButtons()
    task.spawn(function()
        task.wait(2)
        local function hookButtons(parent)
            for _, gui in ipairs(parent:GetDescendants()) do
                if gui:IsA("TextButton") or gui:IsA("ImageButton") then
                    if not gui:GetAttribute("HolexSFXHooked") then
                        gui:SetAttribute("HolexSFXHooked", true)
                        gui.MouseEnter:Connect(function() GlobalSFX:PlayHover() end)
                        gui.MouseButton1Click:Connect(function() GlobalSFX:PlayClick() end)
                    end
                end
            end
        end
        pcall(function() hookButtons((gethui and gethui()) or CoreGui) end)
        pcall(function() hookButtons(Player:WaitForChild("PlayerGui")) end)
    end)
end

