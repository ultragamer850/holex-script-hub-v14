local function NotifyFriendOnline(uname)
    local me = GetChatUsername()
    if not uname or (me and string.lower(uname) == string.lower(me)) then return end
    local friends = UserData.HolexFriends or {}
    local isFriend = false
    for fn, _ in pairs(friends) do
        if string.lower(fn) == string.lower(uname) then isFriend = true break end
    end
    if not isFriend then return end
    local last = getgenv().HolexLastOnlineNotify[string.lower(uname)] or 0
    if os.time() - last < 90 then return end
    getgenv().HolexLastOnlineNotify[string.lower(uname)] = os.time()
    HolexLib:Notify("Friend Online", uname .. " is online on Holex V14", 5, Config.SuccessColor)
end

local function PublishPresence()
    local uname = GetChatUsername()
    if not uname then return end
    local payload = table.concat({
        "presence",
        uname,
        tostring(os.time()),
        tostring(HOLEX_VERSION),
        tostring(Player.UserId),
        tostring(Player.DisplayName or uname),
        UserData.IsGuest and "1" or "0",
        tostring(UserData.JoinedAt or os.time()),
    }, "|")
    NtfyPublish(NTFY_LOBBY, "presence", payload)
    MarkOnline(uname, {
        display = Player.DisplayName,
        userid = Player.UserId,
        lastSeen = os.time(),
        version = HOLEX_VERSION,
        isGuest = UserData.IsGuest,
        joinedAt = UserData.JoinedAt or os.time(),
    })
end

local function PublishTyping()
    local uname = GetChatUsername()
    if not uname then return end
    NtfyPublish(NTFY_LOBBY, "typing", "typing|" .. uname .. "|" .. tostring(os.time()))
end

local function PublishChat(msg)
    local uname = GetChatUsername()
    if not uname then return end
    -- encode pipes in message
    local safe = tostring(msg):gsub("|", "/")
    local payload = table.concat({ "chat", uname, safe, tostring(os.time()) }, "|")
    NtfyPublish(NTFY_LOBBY, "chat", payload)
end

local function PublishDM(toUser, msg)
    local uname = GetChatUsername()
    if not uname then return end
    local a, b = string.lower(uname), string.lower(toUser)
    if a > b then a, b = b, a end
    local topic = "holexv14dm_" .. a:gsub("%W", "") .. "_" .. b:gsub("%W", "")
    if #topic > 64 then topic = "holexv14dm_" .. string.sub(HttpService:GenerateGUID(false):gsub("%-", ""), 1, 20) end
    local safe = tostring(msg):gsub("|", "/")
    local payload = table.concat({ "dm", uname, toUser, safe, tostring(os.time()) }, "|")
    NtfyPublish(topic, "dm", payload)
    NtfyPublish(NTFY_LOBBY, "dm", payload) -- also mirror lightly
    return topic
end

