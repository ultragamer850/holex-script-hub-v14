        end
    end)
end

LoadVoiceSettings()

local function WriteVoiceSignal(payload)
    pcall(function()
        local all = {}
        if isfile and isfile(VOICE_SIGNAL_FILE) then
            all = HttpService:JSONDecode(readfile(VOICE_SIGNAL_FILE)) or {}
        end
        if type(all) ~= "table" then all = {} end
        -- prune old signals (>2 min)
        local now = os.time()
        local cleaned = {}
        for id, sig in pairs(all) do
            if type(sig) == "table" and (now - (sig.time or 0)) < 120 then
                cleaned[id] = sig
            end
        end
        cleaned[payload.id or tostring(now)] = payload
        writefile(VOICE_SIGNAL_FILE, HttpService:JSONEncode(cleaned))
    end)
end

local function ReadVoiceSignals()
    local all = {}
    pcall(function()
        if isfile and isfile(VOICE_SIGNAL_FILE) then
            all = HttpService:JSONDecode(readfile(VOICE_SIGNAL_FILE)) or {}
        end
    end)
    return all
end

local function SetRobloxVoiceMuted(muted)
    pcall(function()
        local VCS = game:GetService("VoiceChatService")
        if VCS then
            -- Best-effort; APIs vary by engine version
            pcall(function()
                if VCS.IsVoiceEnabled and not VCS.IsVoiceEnabled then return end
            end)
        end
    end)
    pcall(function()
        local players = game:GetService("Players")
        local lp = players.LocalPlayer
        if lp then
            -- Some experiences expose mute via player attributes
            lp:SetAttribute("HolexVoiceMuted", muted and true or false)
        end
    end)
end

local function PlayCallRingtone(on)
    pcall(function()
        if VoiceCall.RingtoneSound then
            VoiceCall.RingtoneSound:Stop()
            VoiceCall.RingtoneSound:Destroy()
            VoiceCall.RingtoneSound = nil
        end
        if not on then return end
        if UserData.VoiceSettings and UserData.VoiceSettings.CallRingtone == false then return end
        local snd = Instance.new("Sound")
        snd.SoundId = "rbxassetid://9066622054" -- generic ring-ish tone fallback
        snd.Volume = 0.6
        snd.Looped = true
        snd.Parent = SoundService
        snd:Play()
        VoiceCall.RingtoneSound = snd
    end)
end

function VoiceCall:NotifyStatus(msg)
    for _, cb in ipairs(self.StatusCallbacks) do
        pcall(cb, msg)
    end
    pcall(function()
        if HolexLib and HolexLib.Notify then
            HolexLib:Notify("Voice Call", msg, 4, Config.AccentColor)
        end
    end)
    HolexLogger:Info("VOICE", msg)
end

function VoiceCall:StartCall(target, isGroup, discordInvite)
    if self.InCall then
        return false, "Already in a call — hang up first"
    end
    target = tostring(target or "")
    if target == "" then return false, "No target" end
    self.InCall = true
    self.IsGroup = isGroup and true or false
    self.Target = target
    self.CallId = "call_" .. tostring(Player.UserId) .. "_" .. tostring(math.floor(tick()))
    self.StartedAt = os.time()
    self.DiscordInvite = discordInvite or (UserData.VoiceSettings and UserData.VoiceSettings.PreferredDiscordLink) or ""
    self.Participants = { UserData.Username or Player.Name }
    if not isGroup then
        table.insert(self.Participants, target)
    else
        local g = UserData.HolexGroups and UserData.HolexGroups[target]
        if g and g.members then
            self.Participants = {}
            for _, m in ipairs(g.members) do table.insert(self.Participants, m) end
            if g.discordLink and g.discordLink ~= "" then
                self.DiscordInvite = g.discordLink
            end
        end
    end
    self.Muted = not (UserData.VoiceSettings.MicEnabled ~= false)
    self.Deafened = not (UserData.VoiceSettings.SpeakerEnabled ~= false)
    self.MicDevice = UserData.VoiceSettings.MicDevice or "Default"

    WriteVoiceSignal({
        id = self.CallId,
        type = "invite",
        from = UserData.Username or Player.Name,
        fromId = Player.UserId,
        target = target,
        isGroup = self.IsGroup,
        participants = self.Participants,
        discord = self.DiscordInvite,
        mic = self.MicDevice,
        time = os.time(),
    })

    PlayCallRingtone(true)
    SetRobloxVoiceMuted(self.Muted)
    self:NotifyStatus((isGroup and "Group call started: " or "Calling ") .. target)

    -- Open Discord invite if configured
    if self.DiscordInvite and self.DiscordInvite ~= "" and UserData.VoiceSettings.AutoJoinDiscordVC then
        pcall(function()
            if setclipboard then setclipboard(self.DiscordInvite) end
        end)
        self:NotifyStatus("Discord VC link copied — join for real-time voice")
    end

    LogOwnerActivity("VOICE", "Start call " .. target)
    return true, self.CallId
end

function VoiceCall:AcceptCall(signal)
    if self.InCall then return false, "Already in a call" end
    if type(signal) ~= "table" then return false, "Invalid signal" end
    self.InCall = true
    self.CallId = signal.id
    self.Target = signal.from
    self.IsGroup = signal.isGroup and true or false
    self.Participants = signal.participants or { signal.from, UserData.Username }
    self.DiscordInvite = signal.discord or ""
    self.StartedAt = os.time()
    self.MicDevice = UserData.VoiceSettings.MicDevice or "Default"
    PlayCallRingtone(false)
    SetRobloxVoiceMuted(self.Muted)
    WriteVoiceSignal({
        id = self.CallId .. "_ack",
        type = "accept",
        from = UserData.Username or Player.Name,
        target = signal.from,
        callId = self.CallId,
        time = os.time(),
    })
    self:NotifyStatus("Joined call with " .. tostring(signal.from))
    if self.DiscordInvite ~= "" then
        pcall(function() if setclipboard then setclipboard(self.DiscordInvite) end end)
        self:NotifyStatus("Discord link copied for real-time audio")
    end
    return true
end

function VoiceCall:HangUp()
    if not self.InCall then return false, "Not in a call" end
    WriteVoiceSignal({
        id = (self.CallId or "x") .. "_end",
        type = "hangup",
        from = UserData.Username or Player.Name,
        callId = self.CallId,
        time = os.time(),
    })
    PlayCallRingtone(false)
    local was = self.Target
    self.InCall = false
    self.CallId = nil
    self.Target = nil
    self.IsGroup = false
    self.Participants = {}
    self.StartedAt = 0
    SetRobloxVoiceMuted(false)
    self:NotifyStatus("Call ended" .. (was and (" (" .. tostring(was) .. ")") or ""))
    LogOwnerActivity("VOICE", "Hang up")
    return true
end

function VoiceCall:ToggleMute()
    self.Muted = not self.Muted
    UserData.VoiceSettings.MicEnabled = not self.Muted
    SaveVoiceSettings()
    SetRobloxVoiceMuted(self.Muted)
    self:NotifyStatus(self.Muted and "Microphone muted" or "Microphone unmuted")
    return self.Muted
end

function VoiceCall:ToggleDeafen()
    self.Deafened = not self.Deafened
    UserData.VoiceSettings.SpeakerEnabled = not self.Deafened
    SaveVoiceSettings()
    self:NotifyStatus(self.Deafened and "Deafened" or "Undeafened")
    return self.Deafened
end

function VoiceCall:SetMicDevice(name)
    name = tostring(name or "Default")
    self.MicDevice = name
    UserData.VoiceSettings.MicDevice = name
    SaveVoiceSettings()
    self:NotifyStatus("Mic device: " .. name)
    if self.InCall then
        WriteVoiceSignal({
            id = (self.CallId or "x") .. "_mic",
            type = "mic_change",
            from = UserData.Username or Player.Name,
            callId = self.CallId,
            mic = name,
            time = os.time(),
        })
    end
    return true
end

function VoiceCall:RegisterStatus(cb)
    table.insert(self.StatusCallbacks, cb)
end

