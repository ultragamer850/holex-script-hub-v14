local function countTable(t)
    local count = 0
    if t then for _ in pairs(t) do count = count + 1 end end
    return count
end

-- ==================== HOLEX LOGGER (NEW) ====================
local HolexLogger = {}
HolexLogger.Logs = {}
HolexLogger.MaxLogs = 500
HolexLogger.OnLogCallbacks = {}

function HolexLogger:Log(source, message, level)
    level = level or "INFO"
    local entry = {
        time = os.date("%H:%M:%S"),
        source = source or "SYSTEM",
        message = tostring(message),
        level = level
    }
    table.insert(self.Logs, entry)
    if #self.Logs > self.MaxLogs then
        table.remove(self.Logs, 1)
    end
    -- Save to file
    pcall(function()
        local logText = string.format("[%s] [%s] [%s] %s\n", entry.time, entry.level, entry.source, entry.message)
        appendfile(LOGS_FOLDER .. "/holex_log.txt", logText)
    end)
    -- Notify callbacks
    for _, cb in ipairs(self.OnLogCallbacks) do
        pcall(cb, entry)
    end
    print(string.format("[Holex:%s] %s: %s", level, source, message))
end

function HolexLogger:Info(source, msg) self:Log(source, msg, "INFO") end
function HolexLogger:Success(source, msg) self:Log(source, msg, "SUCCESS") end
function HolexLogger:Warn(source, msg) self:Log(source, msg, "WARN") end
function HolexLogger:Error(source, msg) self:Log(source, msg, "ERROR") end

function HolexLogger:RegisterCallback(cb)
    table.insert(self.OnLogCallbacks, cb)
end

function HolexLogger:GetLogs() return self.Logs end
function HolexLogger:Clear()
    self.Logs = {}
    pcall(function() delfile(LOGS_FOLDER .. "/holex_log.txt") end)
end

