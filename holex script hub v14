task.spawn(function()
    local seen = {}
    while true do
        task.wait(2.5)
        if UserData.LoggedIn then -- gate
        local signals = ReadVoiceSignals()
        local me = (UserData.Username or ""):lower()
        for id, sig in pairs(signals) do
            if type(sig) == "table" and not seen[id] then
                seen[id] = true
                if sig.type == "invite" and not VoiceCall.InCall then
                    local target = tostring(sig.target or ""):lower()
                    local isForMe = target == me
                    if not isForMe and sig.isGroup and UserData.HolexGroups then
                        local g = UserData.HolexGroups[sig.target]
                        if g and g.members then
                            for _, m in ipairs(g.members) do
                                if tostring(m):lower() == me then isForMe = true break end
                            end
                        end
                    end
                    if isForMe and tostring(sig.from or ""):lower() ~= me then
                        PlayCallRingtone(true)
                        pcall(function()
                            if HolexLib and HolexLib.Notify then
                                HolexLib:Notify("Incoming Call", (sig.from or "?") .. " is calling you!\nOpen Voice Call tab to Accept / Decline", 10, Config.WarningColor)
                            end
                        end)
                        VoiceCall._pending = sig
                        HolexLogger:Info("VOICE", "Incoming call from " .. tostring(sig.from))
                    end
                elseif sig.type == "hangup" and VoiceCall.InCall and sig.callId == VoiceCall.CallId then
                    VoiceCall:HangUp()
                end
            end
        end
        end -- logged in gate
        -- limit seen map size
        local n = 0
        for _ in pairs(seen) do n = n + 1 end
        if n > 200 then seen = {} end
    end
end)

