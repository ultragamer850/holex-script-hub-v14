local function parseScriptsFromBody(body)
    if not body or body == "" then return {}, "empty" end
    if tostring(body):find("Internal Server error") or tostring(body):find("Coming Soon") then
        return {}, "api_down"
    end
    local data = nil
    pcall(function() data = HttpService:JSONDecode(body) end)
    if not data then return {}, "bad_json" end
    if data.message and type(data.message) == "string" and data.message:find("error") then
        return {}, "api_error:" .. data.message
    end
    local scripts = (data.result and data.result.scripts)
        or data.scripts
        or data.result
        or data.data
        or {}
    if type(scripts) ~= "table" then return {}, "bad_shape" end
    -- if dictionary not array
    if scripts[1] == nil and next(scripts) ~= nil then
        local arr = {}
        for _, v in pairs(scripts) do
            if type(v) == "table" and (v.title or v.name) then table.insert(arr, v) end
        end
        scripts = arr
    end
    return scripts, "ok"
end

local function fallbackSearch(query, page)
    page = page or 1
    local q = (query or ""):lower()
    local matched = {}
    for _, s in ipairs(HolexScriptFallback) do
        local hay = ((s.title or "") .. " " .. (s.slug or "") .. " " .. ((s.game and s.game.name) or "")):lower()
        if q == "" or q == "script" or hay:find(q, 1, true) then
            table.insert(matched, s)
        end
    end
    local per = 10
    local start = (page - 1) * per + 1
    local slice = {}
    for i = start, math.min(start + per - 1, #matched) do
        table.insert(slice, matched[i])
    end
    return slice, math.max(1, math.ceil(#matched / per))
end

local sbState = sbState or { query = "universal", page = 1 }
local function doSearch(query, page)
    page = tonumber(page) or 1
    if page < 1 then page = 1 end
    clearSbResults()
    sbState.query = query or sbState.query
    sbState.page = page
    local src = sbSource or "Auto"
    HolexLib:Notify("Scripts", "[" .. src .. "] " .. tostring(query) .. " p" .. tostring(page), 3)
    task.spawn(function()
        local scripts, used = {}, src
        local qenc = HttpService:UrlEncode(tostring(query or ""))
        local function parseBody(body)
            if not body or body == "" then return {} end
            if tostring(body):find("Internal Server error") or tostring(body):find("Coming Soon") then return {} end
            local data
            pcall(function() data = HttpService:JSONDecode(body) end)
            if not data then return {} end
            local list = (data.result and data.result.scripts) or data.scripts or data.result or data.data or {}
            if type(list) ~= "table" then return {} end
            if list[1] == nil then
                local arr = {}
                for _, v in pairs(list) do
                    if type(v) == "table" and (v.title or v.name) then table.insert(arr, v) end
                end
                return arr
            end
            return list
        end
        local function fetchScriptBlox()
            local urls = {
                "https://scriptblox.com/api/script/search?q=" .. qenc .. "&max=20&page=" .. tostring(page) .. "&sortBy=views&order=desc",
                "https://scriptblox.com/api/script/search?q=" .. qenc .. "&page=" .. tostring(page),
            }
            for _, url in ipairs(urls) do
                local res = Utilities:HTTPRequest(url, "GET")
                local list = parseBody(res and (res.Body or res.body))
                if #list > 0 then return list end
            end
            return {}
        end
        local function fetchRscripts()
            local urls = {
                "https://rscripts.net/api/scripts?page=" .. tostring(page) .. "&q=" .. qenc,
            }
            for _, url in ipairs(urls) do
                local res = Utilities:HTTPRequest(url, "GET")
                local body = res and (res.Body or res.body)
                if body and not tostring(body):find("<!DOCTYPE") then
                    local list = parseBody(body)
                    if #list > 0 then
                        for _, s in ipairs(list) do
                            s.title = s.title or s.name
                            s._holexRaw = s.raw or s.script or s.download
                        end
                        return list
                    end
                end
            end
            return {}
        end
        local function fetchFallback()
            local catalog = {
                { title = "Infinite Yield", verified = true, isUniversal = true, views = 999999, game = { name = "Universal" },
                  raw = "https://raw.githubusercontent.com/EdgeIY/infiniteyield/master/source" },
                { title = "Dex Explorer", verified = true, isUniversal = true, views = 500000, game = { name = "Universal" },
                  raw = "https://raw.githubusercontent.com/infyiff/backup/main/dex.lua" },
                { title = "Unnamed ESP", verified = true, isUniversal = true, views = 300000, game = { name = "Universal" },
                  raw = "https://raw.githubusercontent.com/ic3w0lf22/Unnamed-ESP/master/UnnamedESP.lua" },
                { title = "Dark Dex", verified = true, isUniversal = true, views = 250000, game = { name = "Universal" },
                  raw = "https://raw.githubusercontent.com/Babyhamsta/RBLX_Scripts/main/Universal/BypassedDarkDexV3.lua" },
                { title = "Remote Spy", verified = true, isUniversal = true, views = 400000, game = { name = "Universal" },
                  raw = "https://raw.githubusercontent.com/infyiff/backup/main/SimpleSpyV3/main.lua" },
            }
            local q = tostring(query or ""):lower()
            local out = {}
            for _, s in ipairs(catalog) do
                if q == "" or q == "script" or (s.title:lower():find(q, 1, true)) then
                    s._holexRaw = s.raw
                    table.insert(out, s)
                end
            end
            return out
        end
        if src == "ScriptBlox" then
            scripts = fetchScriptBlox(); used = "ScriptBlox"
        elseif src == "Rscripts" then
            scripts = fetchRscripts(); used = "Rscripts"
        elseif src == "RobloxScripts" or src == "HaxHell" or src == "Fallback" then
            scripts = fetchFallback(); used = src
        else -- Auto
            scripts = fetchScriptBlox(); used = "ScriptBlox"
            if #scripts == 0 then scripts = fetchRscripts(); used = "Rscripts" end
            if #scripts == 0 then scripts = fetchFallback(); used = "Fallback" end
        end
        if #scripts == 0 then
            scripts = fetchFallback(); used = "Fallback"
        end
        pcall(function()
            if sbStatusPara and sbStatusPara.SetValue then
                sbStatusPara:SetValue("Using: " .. used .. " · " .. #scripts .. " results")
            end
        end)
        if #scripts == 0 then
            HolexLib:Notify("Scripts", "No results", 4, Config.WarningColor)
            sbResultsSec:CreateParagraph({ Title = "No results", Content = "Try another source or query." })
            return
        end
        HolexLib:Notify("Scripts", used .. ": " .. #scripts .. " scripts", 3, Config.SuccessColor)
        sbResultsSec:CreateParagraph({ Title = "Results · " .. used, Content = "Page " .. tostring(page) })
        for _, s in ipairs(scripts) do
            if s.raw and not s._holexRaw then s._holexRaw = s.raw end
            renderScriptCard(s, sbResultsSec.Content)
        end
        sbResultsSec:CreateButton({
            Title = "⬅ Prev Page",
            Callback = function() if page > 1 then doSearch(query, page - 1) end end
        })
        sbResultsSec:CreateButton({
            Title = "Next Page ➡",
            Callback = function() doSearch(query, page + 1) end
        })
    end)
end

