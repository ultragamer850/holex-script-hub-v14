local function getAsset(url, filename)
    -- Always store under HolexData/alerts so workspace stays clean
    local path = filename
    if not tostring(filename):find("HolexData") then
        path = ALERTS_FOLDER .. "/" .. filename
    end
    pcall(function() if HolexEnsureDir then HolexEnsureDir(path) end end)
    if not (isfile and isfile(path)) then
        local success, data = pcall(function() return game:HttpGet(url) end)
        if success and data then
            pcall(function()
                if writefile then writefile(path, data) end
            end)
        end
    end
    local asset = nil
    pcall(function()
        if getcustomasset and isfile and isfile(path) then
            asset = getcustomasset(path)
        end
    end)
    return asset
end

