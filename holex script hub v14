function BreakingNews:FetchAndShow()
    HolexLogger:Info("NEWS", "Fetching real-world news...")
    task.spawn(function()
        local country = NetworkInfo.Country or "Unknown"
        local city = NetworkInfo.City or ""
        local region = NetworkInfo.Region or ""
        local code = (NetworkInfo.CountryCode or "US"):upper()

        -- Multiple real-life news categories (Google News RSS)
        local queries = {
            { label = "Top Stories", q = "top+stories" },
            { label = "World", q = "world+news" },
            { label = "War & Conflict", q = "war+OR+conflict+OR+military" },
            { label = "Crime", q = "crime+OR+murder+OR+arrest" },
            { label = "FBI / Federal", q = "FBI+OR+federal+investigation+OR+indictment" },
            { label = "Killings / Cases", q = "homicide+OR+serial+killer+OR+manslaughter+case" },
            { label = "Politics", q = "politics+OR+government+election" },
            { label = "Local", q = (city ~= "" and city:gsub("%s+", "+") or country:gsub("%s+", "+")) .. "+news" },
        }

        local headlines = {}
        local function clean(s)
            if not s then return "" end
            s = s:gsub("<.->", "")
            s = s:gsub("&amp;", "&"):gsub("&lt;", "<"):gsub("&gt;", ">"):gsub("&quot;", '"'):gsub("&#39;", "'"):gsub("&nbsp;", " ")
            s = s:gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
            return s
        end

        for _, cat in ipairs(queries) do
            local url = string.format(
                "https://news.google.com/rss/search?q=%s&hl=en-US&gl=US&ceid=US:en",
                cat.q
            )
            -- also try country-specific for local
            if cat.label == "Local" and code and code ~= "" then
                url = string.format(
                    "https://news.google.com/rss/search?q=%s&hl=en-%s&gl=%s&ceid=%s:en",
                    cat.q, code, code, code
                )
            end
            local ok, res = pcall(function() return game:HttpGet(url) end)
            if ok and res and type(res) == "string" then
                -- collect several <item> titles
                local count = 0
                for item in res:gmatch("<item>(.-)</item>") do
                    local title = item:match("<title>(.-)</title>")
                    local desc = item:match("<description>(.-)</description>")
                    title = clean(title)
                    desc = clean(desc)
                    if title and #title > 10 and not title:lower():find("google news") then
                        table.insert(headlines, {
                            category = cat.label,
                            title = title,
                            desc = (desc and #desc > 5) and desc or ("Report from " .. cat.label .. " desk."),
                        })
                        count = count + 1
                        if count >= 2 then break end
                    end
                end
            end
            task.wait(0.15)
        end

        if #headlines == 0 then
            -- Ultimate fallback
            local ok, res = pcall(function()
                return game:HttpGet("https://news.google.com/rss?hl=en-US&gl=US&ceid=US:en")
            end)
            if ok and res then
                for item in res:gmatch("<item>(.-)</item>") do
                    local title = clean(item:match("<title>(.-)</title>"))
                    if title and #title > 10 then
                        table.insert(headlines, { category = "Top Stories", title = title, desc = "Breaking report." })
                        if #headlines >= 5 then break end
                    end
                end
            end
        end

        if #headlines == 0 then
            HolexLib:Notify("Breaking News", "Could not fetch news right now. Try again.", 5, Config.WarningColor)
            return
        end

        -- Build a spoken briefing for the player
        local briefingParts = {
            string.format("News briefing for %s, %s, %s.", city ~= "" and city or "your area", region ~= "" and region or "", country)
        }
        local showTitle = headlines[1].title
        local showDesc = ""
        for i, h in ipairs(headlines) do
            if i > 8 then break end
            table.insert(briefingParts, string.format("%s: %s.", h.category, h.title))
            showDesc = showDesc .. string.format("[%s] %s\n", h.category, h.title)
            table.insert(self.NewsHistory, { title = h.title, desc = h.desc, category = h.category, time = os.time() })
        end
        showDesc = showDesc .. "\nYou are in " .. tostring(city) .. ", " .. tostring(region) .. ", " .. tostring(country) .. "."
        local briefing = table.concat(briefingParts, " ")

        self:Show(showTitle, showDesc, briefing)
        HolexLib:Notify("Breaking News", #headlines .. " reports loaded", 4, Config.SuccessColor)
    end)
end

function BreakingNews:GetHistory() return self.NewsHistory end

