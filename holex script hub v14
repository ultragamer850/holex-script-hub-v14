        if gpe then return end
        local mk = Config.MusicKey
        if mk and mk ~= "None" and Enum.KeyCode[mk] and input.KeyCode == Enum.KeyCode[mk] then
            if CurrentMusic.Sound then
                if CurrentMusic.Sound.IsPlaying then
                    CurrentMusic.Sound:Pause()
                    CurrentMusic.Playing = false
                else
                    CurrentMusic.Sound:Resume()
                    CurrentMusic.Playing = true
                end
            end
        end
        local sb = Config.SeekBackKey
        if sb and sb ~= "None" and Enum.KeyCode[sb] and input.KeyCode == Enum.KeyCode[sb] then
            if CurrentMusic.Sound then
                CurrentMusic.Sound.TimePosition = math.max(0, CurrentMusic.Sound.TimePosition - 5)
            end
        end
        local sf = Config.SeekForwardKey
        if sf and sf ~= "None" and Enum.KeyCode[sf] and input.KeyCode == Enum.KeyCode[sf] then
            if CurrentMusic.Sound then
                local t = CurrentMusic.Sound.TimePosition + 5
                local len = CurrentMusic.Sound.TimeLength
                if len > 0 then t = math.min(t, len - 0.1) end
                CurrentMusic.Sound.TimePosition = t
            end
        end
    end)
end)

