local function CheckBanStatus()
    if not UserData.BanStatus or not UserData.BanStatus.banned then return false end
    local ban = UserData.BanStatus
    if ban.expires > 0 and os.time() > ban.expires then
        UserData.BanStatus = { banned = false, level = 0, expires = 0, reason = "" }
        SaveUserData()
        return false
    end
    return true
end

local function IssueBan(username, level, reason)
    local banTimes = { [1] = 600, [2] = 1200, [3] = 86400, [4] = 172800, [5] = 259200, [6] = 345600, [7] = 691200, [8] = -1 }
    local banDuration = banTimes[level] or 600
    UserData.BanStatus = {
        banned = true,
        level = level,
        expires = banDuration == -1 and -1 or (os.time() + banDuration),
        reason = reason or "Violation of Holex ToS"
    }
    SaveUserData()
    HolexLogger:Warn("BAN", username .. " banned for " .. tostring(banDuration) .. "s: " .. (reason or "Unknown"))
end

