-- ==================== VOICE CALL SYSTEM (Holex + Discord bridge) ====================
-- Real-time peer mic audio cannot be fully streamed by pure client Lua alone.
-- This system provides: call UI, mic device preference, mute/deafen, group calls,
-- call signaling via HolexData presence files, Discord VC deep-links, and
-- Roblox VoiceChatService mute control when the experience supports it.

local VOICE_SIGNAL_FILE = HOLEX_DATA .. "/voice_signals.json"
local VOICE_SETTINGS_FILE = HOLEX_DATA .. "/voice_settings.json"

local VoiceCall = {
    InCall = false,
    CallId = nil,
    Target = nil, -- username or group id
    IsGroup = false,
    Muted = false,
    Deafened = false,
    MicDevice = "Default",
    MicDevices = {
        "Default",
        "System Default Microphone",
        "Headset Microphone",
        "USB Microphone",
        "Laptop Built-in Mic",
        "External Webcam Mic",
        "Virtual Cable / VB-Audio",
        "Discord Input (System)",
    },
    Participants = {},
    StartedAt = 0,
    DiscordInvite = "",
    RingtoneSound = nil,
    StatusCallbacks = {},
}

local function LoadVoiceSettings()
    pcall(function()
        if isfile and isfile(VOICE_SETTINGS_FILE) then
            local data = HttpService:JSONDecode(readfile(VOICE_SETTINGS_FILE))
            if type(data) == "table" then
                for k, v in pairs(data) do
                    UserData.VoiceSettings[k] = v
                end
            end
        end
    end)
    UserData.VoiceSettings = UserData.VoiceSettings or {}
    VoiceCall.MicDevice = UserData.VoiceSettings.MicDevice or "Default"
    VoiceCall.Muted = not (UserData.VoiceSettings.MicEnabled ~= false)
end

local function SaveVoiceSettings()
