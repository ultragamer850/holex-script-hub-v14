local function UpsertSavedAccount(username, password, isGuest, profilePic)
    if not username or username == "" then return false end
    UserData.SavedAccounts = UserData.SavedAccounts or {}
    local found = false
    for _, acc in ipairs(UserData.SavedAccounts) do
        if acc.Username and acc.Username:lower() == username:lower() then
            acc.Password = password or acc.Password or ""
            acc.IsGuest = isGuest and true or false
            acc.ProfilePic = profilePic or acc.ProfilePic or ""
            acc.LastUsed = os.time()
            found = true
            break
        end
    end
    if not found then
        table.insert(UserData.SavedAccounts, {
            Username = username,
            Password = password or "",
            IsGuest = isGuest and true or false,
            ProfilePic = profilePic or "",
            LastUsed = os.time(),
        })
    end
    SaveSavedAccounts()
    return true
end

local function RemoveSavedAccount(username)
    if not username then return false end
    local out = {}
    for _, acc in ipairs(UserData.SavedAccounts or {}) do
        if not (acc.Username and acc.Username:lower() == username:lower()) then
            table.insert(out, acc)
        end
    end
    UserData.SavedAccounts = out
    SaveSavedAccounts()
    return true
end

local function SwitchHolexAccount(username)
    local target = nil
    for _, acc in ipairs(UserData.SavedAccounts or {}) do
        if acc.Username and acc.Username:lower() == tostring(username):lower() then
            target = acc
            break
        end
    end
    if not target then
        return false, "Account not found in saved list"
    end
    -- Save current first
    if UserData.LoggedIn and UserData.Username and UserData.Username ~= "" then
        UpsertSavedAccount(UserData.Username, UserData.Password, UserData.IsGuest, UserData.ProfilePic)
    end
    UserData.LoggedIn = true
    UserData.Username = target.Username
    UserData.Password = target.Password or ""
    UserData.IsGuest = target.IsGuest and true or false
    UserData.ProfilePic = target.ProfilePic or ("rbxthumb://type=AvatarHeadShot&id=" .. Player.UserId .. "&w=150&h=150")
    UserData.AcceptedTOS = true
    target.LastUsed = os.time()
    SaveSavedAccounts()
    SaveUserData()
    HolexLogger:Success("ACCOUNT", "Switched to account: " .. target.Username)
    pcall(function()
        if HolexLib and HolexLib.Notify then
            HolexLib:Notify("Account Switch", "Now using: " .. target.Username, 4, Config.SuccessColor)
        end
    end)
    -- Update sidebar labels if main UI is open
    pcall(function()
        if ScreenGui then
            local main = ScreenGui:FindFirstChild("MainFrame")
            if main then
                for _, d in ipairs(main:GetDescendants()) do
                    if d:IsA("TextLabel") and (d.Text == "OWNER" or d.Text == "Guest User" or d.Text == "Member" or #d.Text > 0) then
                        -- soft update profile name labels near profile frame
                    end
                end
            end
        end
    end)
    return true, target.Username
end

