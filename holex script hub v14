local function getImageUrl(script)
    local placeId = nil
    if type(script.game) == "table" then
        placeId = script.game.placeId or script.game.rootPlaceId or script.game.id or script.game.gameId
        if type(placeId) == "string" then placeId = tonumber(placeId) end
    end
    if placeId and tonumber(placeId) and tonumber(placeId) > 0 then
        return string.format("rbxthumb://type=GameIcon&id=%s&w=150&h=150", tostring(placeId))
    end
    local img = (script.game and script.game.imageUrl) or script.image
    if img and img ~= "" then
        if img:find("rbxthumb://") or img:find("rbxassetid://") then return img end
        if img:find("rbxcdn.com") or img:find("roblox.com") then return img end
    end
    return "rbxassetid://6031075931"
end

local function executeScriptSource(src, title)
    if not src or src == "" then
        HolexLib:Notify("ScriptBlox", "No script source available", 4, Config.WarningColor)
        return
    end
    local ok, err = pcall(function()
        local fn, loadErr = loadstring(src)
        if not fn then error(loadErr or "loadstring failed") end
        fn()
    end)
    if ok then
        HolexLib:Notify("ScriptBlox", "Executed: " .. (title or "Script"), 4, Config.SuccessColor)
        HolexLogger:Success("SCRIPTBLOX", "Executed " .. tostring(title))
    else
        HolexLib:Notify("ScriptBlox", "Execute failed: " .. tostring(err), 6, Config.ErrorColor)
        HolexLogger:Error("SCRIPTBLOX", tostring(err))
    end
end

